        "import subprocess\n",
        "import time\n",
        "from pathlib import Path\n",
        "import torch\n",
        "import os\n",
        "\n",
        "assert torch.cuda.is_available(), \"Select a CUDA GPU runtime in Colab first.\"\n",
        "GPU_COUNT = torch.cuda.device_count()\n",
        "\n",
        "MODEL_ID = \"MiniMaxAI/MiniMax-H3\"\n",
        "PORT = 30010\n",
        "BASE_URL = f\"http://127.0.0.1:{PORT}\"\n",
        "MIN_GPU_GIB = min(torch.cuda.get_device_properties(i).total_memory / 1024**3\n",
        "                  for i in range(GPU_COUNT))\n",
        "PROFILE = (\"four_gpu\" if GPU_COUNT >= 4 and MIN_GPU_GIB >= 78 else\n",
        "           \"single_large\" if MIN_GPU_GIB >= 78 else \"single_safe\")\n",
        "DIT_RESIDENT_LAYERS = 0  # Single-GPU capacity baseline; increase only after measuring available VRAM.\n",
        "SERVER_LOG = Path(\"/content/sglang_h3_ref2va.log\")\n",
        "\n",
        "if PROFILE == \"four_gpu\":\n",
        "    assert GPU_COUNT >= 4, \"four_gpu requires at least four visible GPUs.\"\n",
        "    hardware_args = [\"--num-gpus\", \"4\", \"--tp-size\", \"2\", \"--ulysses-degree\", \"2\",\n",
        "                     \"--encoder-parallel\", \"auto\", \"--performance-mode\", \"speed\"]\n",
        "elif PROFILE in (\"single_safe\", \"single_large\"):\n",
        "    hardware_args = [\"--num-gpus\", \"1\", \"--quantization\", \"kitchen_int8\",\n",
        "                     \"--attention-backend\", \"sage_attn\", \"--enable-torch-compile\", \"false\"]\n",
        "    if PROFILE == \"single_large\":\n",
        "        hardware_args += [\"--performance-mode\", \"speed\",\n",
        "                          \"--layerwise-offload-components\", \"text_encoder\"]\n",
        "    else:\n",
        "        hardware_args += [\"--performance-mode\", \"memory\",\n",
        "                          \"--layerwise-offload-components\", \"dit,text_encoder\",\n",
        "                          \"--dit-offload-prefetch-size\", \"1\",\n",
        "                          \"--dit-layerwise-resident-layers\", str(DIT_RESIDENT_LAYERS)]\n",
        "else:\n",
        "    raise ValueError(f\"Unknown PROFILE: {PROFILE}\")\n",
        "\n",
        "cmd = [\"sglang\", \"serve\", \"--model-path\", MODEL_ID, \"--model-variant\", \"ref2va\",\n",
        "       \"--host\", \"127.0.0.1\", \"--port\", str(PORT), *hardware_args]\n",
        "\n",
        "# Rerunning this cell restarts only the process started by this notebook.\n",
        "if \"sglang_process\" in globals() and sglang_process.poll() is None:\n",
        "    sglang_process.terminate()\n",
        "    try:\n",
        "        sglang_process.wait(timeout=30)\n",
        "    except subprocess.TimeoutExpired:\n",
        "        sglang_process.kill()\n",
        "        sglang_process.wait()\n",
        "\n",
        "import requests\n",
        "try:\n",
        "    response = requests.get(f\"{BASE_URL}/health\", timeout=2)\n",
        "    if response.ok:\n",
        "        raise RuntimeError(f\"Port {PORT} already has a server. Stop it or change PORT to avoid using the wrong model.\")\n",
        "except requests.RequestException:\n",
        "    pass\n",
        "\n",
        "print(\"Starting:\", \" \".join(cmd))\n",
        "with SERVER_LOG.open(\"w\") as log:\n",
        "    sglang_process = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT,\n",
        "                                      start_new_session=True, env=os.environ.copy())\n",
        "\n",
        "startup_deadline = time.monotonic() + 3600  # Allow first-time checkpoint download and warmup.\n",
        "next_report = 0\n",
        "while time.monotonic() < startup_deadline:\n",
        "    if sglang_process.poll() is not None:\n",
        "        raise RuntimeError(f\"SGLang exited ({sglang_process.returncode}). Log tail:\\n\" +\n",
        "                           \"\\n\".join(SERVER_LOG.read_text(errors=\"replace\").splitlines()[-50:]))\n",
        "    try:\n",
        "        if requests.get(f\"{BASE_URL}/health\", timeout=5).ok:\n",
        "            print(\"SGLang health endpoint is ready. Server log:\", SERVER_LOG)\n",
        "            break\n",
        "    except requests.RequestException:\n",
        "        pass\n",
        "    if time.monotonic() >= next_report:\n",
        "        print(\"Loading H3 weights / warming up...\", time.strftime(\"%H:%M:%S\"))\n",
        "        next_report = time.monotonic() + 30\n",
        "    time.sleep(5)\n",
        "else:\n",
        "    raise TimeoutError(f\"Server did not become healthy in one hour. Inspect {SERVER_LOG}.\")"
      ],
