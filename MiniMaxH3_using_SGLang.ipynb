      "source": [
        "## Start the reference model\n",
        "\n",
        "`single_large` (80+ GiB) keeps the INT8 transformer on the GPU and offloads the text encoder. `single_safe` streams the transformer and encoder on smaller GPUs; you can raise `DIT_RESIDENT_LAYERS` after a successful baseline run. `four_gpu` uses four 80+ GiB cards with TP2 and Ulysses2. Set `PROFILE` manually to override the choice if your workload runs out of memory. This server stays active across subsequent notebook cells."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import sys\n",
        "import sysconfig\n",
        "import subprocess\n",
        "import importlib.metadata\n",
        "from pathlib import Path\n",
        "\n",
        "# Path for the new virtual environment\n",
        "env_dir = Path(\"/content/sglang_venv\")\n",
        "env_python = env_dir / \"bin/python\"\n",
        "sglang_cli = env_dir / \"bin/sglang\"\n",
        "\n",
        "# Install into the Python running this Colab notebook.\n",
        "# This first step installs general tools like 'uv' and 'requests'.\n",
        "# 'comfy-kitchen' is also installed here, but will be re-installed in the venv for sglang.\n",
        "subprocess.run(\n",
        "    [sys.executable, \"-m\", \"pip\", \"install\", \"-U\",\n",
        "     \"uv\", \"requests\", \"comfy-kitchen\"],\n",
        "    check=True,\n",
        ")\n",
        "\n",
        "# Create a virtual environment with Python 3.12 using uv\n",
        "print(f\"Creating a Python 3.12 virtual environment at {env_dir}...\")\n",
        "subprocess.run(\n",
        "    [sys.executable, \"-m\", \"uv\", \"venv\",\n",
        "     \"--python\", \"3.12\", str(env_dir)],\n",
        "    check=True,\n",
        ")\n",
        "print(\"Virtual environment created.\")\n",
        "\n",
        "# Install sglang[diffusion] and comfy-kitchen into the new Python 3.12 virtual environment\n",
        "print(f\"Installing sglang[diffusion] and comfy-kitchen into {env_python}...\")\n",
        "subprocess.run(\n",
        "    [sys.executable, \"-m\", \"uv\", \"pip\", \"install\",\n",
        "     \"--python\", str(env_python),\n",
        "     \"sglang[diffusion]\", \"comfy-kitchen\",\n",
        "     \"--prerelease=allow\"],\n",
        "    check=True,\n",
        ")\n",
        "print(\"sglang[diffusion] and comfy-kitchen installed in the virtual environment.\")\n",
        "\n",
        "# Make the installed CLI visible to your existing server cell.\n",
        "# The sglang CLI will now be located in the new virtual environment's bin directory.\n",
        "if not sglang_cli.is_file():\n",
        "    raise RuntimeError(f\"SGLang CLI was not installed at {sglang_cli}\")\n",
        "\n",
        "os.environ[\"PATH\"] = f\"{env_dir / 'bin'}:{os.environ['PATH']}\"\n",
        "print(\"SGLang CLI path updated in PATH.\")\n",
        "\n",
        "# Verify SGLang version using the new environment's python\n",
        "sglang_version_output = subprocess.run(\n",
        "    [str(env_python), \"-c\", \"import importlib.metadata; print(importlib.metadata.version('sglang'))\"],\n",
        "    capture_output=True, text=True, check=True\n",
        ").stdout.strip()\n",
        "\n",
        "print(\"SGLang version:\", sglang_version_output)\n",
        "print(\"CLI ready:\", sglang_cli)\n",
        "print(\"Notebook Python remains:\", sys.executable)"
      ],
