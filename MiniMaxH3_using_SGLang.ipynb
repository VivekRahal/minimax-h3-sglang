      "source": [
        "import os\n",
        "import shutil\n",
        "import torch\n",
        "\n",
        "os.environ.setdefault(\"HF_HOME\", \"/content/hf_cache\")\n",
        "os.environ.setdefault(\"HF_HUB_CACHE\", \"/content/hf_cache/hub\")\n",
        "\n",
        "assert torch.cuda.is_available(), \"Select a CUDA GPU runtime in Colab first.\"\n",
        "GPU_COUNT = torch.cuda.device_count()\n",
        "print(\"PyTorch:\", torch.__version__)\n",
        "for i in range(GPU_COUNT):\n",
        "    p = torch.cuda.get_device_properties(i)\n",
        "    print(f\"GPU {i}: {p.name}, {p.total_memory / 1024**3:.1f} GiB\")\n",
        "print(\"Disk free:\", round(shutil.disk_usage(\"/content\").free / 1024**3, 1), \"GiB\")\n",
        "print(\"Host RAM:\", round(os.sysconf('SC_PHYS_PAGES') * os.sysconf('SC_PAGE_SIZE') / 1024**3, 1), \"GiB\")\n",
        "if shutil.disk_usage(\"/content\").free < 120 * 1024**3:\n",
        "    print(\"WARNING: The official H3 checkpoint plus downloads/cache may not fit on this disk.\")"
      ],
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
