        "     \"--prerelease=allow\"],\n",
        "    check=True,\n",
        ")\n",
        "\n",
        "assert sglang_cli.is_file(), f\"Missing SGLang executable: {sglang_cli}\"\n",
        "os.environ[\"PATH\"] = f\"{env_dir / 'bin'}:{os.environ['PATH']}\"\n",
        "\n",
        "print(\"SGLang ready:\", sglang_cli)\n",
        "print(\"Notebook Python remains:\", sys.executable)"
