      "source": [
        "## Upload references\n",
        "\n",
        "Upload images, videos, and optional audio **in the desired order**. Rerun the upload cell to append references; run the reset cell first to start a new set. Tags use one based order within each media type: `<Picture 1>`, `<Video 1>`, `<Audio 1>`. A video soundtrack may also be exposed as an audio tag by H3. The media paths must be visible to the local SGLang server, which they are in this Colab runtime."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "8FKNZCbmJppm"
      },
      "source": [
        "items = []  # Run this cell to clear previous uploads."
      ],
      "execution_count": 18,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 249
        },
        "id": "N35SEDJxJppm",
        "outputId": "74161086-3692-43db-f25e-4786afc75e51"
      },
      "source": [
        "from google.colab import files\n",
        "from pathlib import Path\n",
        "\n",
        "uploaded = files.upload()\n",
        "IMAGE_EXTENSIONS = {\".png\", \".jpg\", \".jpeg\", \".webp\", \".bmp\"}\n",
        "VIDEO_EXTENSIONS = {\".mp4\", \".mov\", \".mkv\", \".webm\", \".avi\"}\n",
        "AUDIO_EXTENSIONS = {\".wav\", \".mp3\", \".m4a\", \".flac\", \".aac\", \".ogg\"}\n",
        "\n",
        "for filename in uploaded:\n",
        "    path = Path(\"/content\", filename).resolve()\n",
        "    suffix = path.suffix.lower()\n",
        "    if suffix in IMAGE_EXTENSIONS:\n",
        "        kind = \"image\"\n",
        "    elif suffix in VIDEO_EXTENSIONS:\n",
        "        kind = \"video\"\n",
        "    elif suffix in AUDIO_EXTENSIONS:\n",
        "        kind = \"audio\"\n",
        "    else:\n",
        "        print(\"Skipped unsupported file:\", filename)\n",
        "        continue\n",
        "    items.append((kind, str(path)))\n",
        "    print(f\"Added {kind}: {path}\")\n",
        "print(\"Ordered items:\", items)"
      ],
