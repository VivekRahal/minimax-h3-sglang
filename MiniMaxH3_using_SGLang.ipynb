        "env_python = env_dir / \"bin/python\"\n",
        "sglang_cli = env_dir / \"bin/sglang\"\n",
        "\n",
        "# uv downloads Python 3.12 if Colab does not already have it.\n",
        "subprocess.run(\n",
        "    [sys.executable, \"-m\", \"uv\", \"venv\",\n",
        "     \"--python\", \"3.12\", str(env_dir)],\n",
        "    check=True,\n",
        ")\n",
        "subprocess.run(\n",
        "    [sys.executable, \"-m\", \"uv\", \"pip\", \"install\",\n",
        "     \"--python\", str(env_python),\n",
